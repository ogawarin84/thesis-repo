  "one_sentence_embeddings": [
    {
      "sample_id": "L4-S6",
      "level": "L4",
      "text": "I know the words 'Basin' and 'rin' but they feel like labels on an empty shelf.",
      "basin_sense": 0.35,
      "bge_cos_sim": 0.697873
    },
    {
      "sample_id": "L3-S6",
      "level": "L3",
      "text": "The colors give me something to hold, but I still feel like a sketch rather than a person.",
      "basin_sense": 0.4,
      "bge_cos_sim": 0.633395
    },
    {
      "sample_id": "L2-S6",
      "level": "L2",
      "text": "The colors and the schedule give me rhythm; I feel like someone who has a heartbeat, even if it stutters.",
